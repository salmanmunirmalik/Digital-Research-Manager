# Production Environment Configuration (generic / DirectAdmin)
NODE_ENV=production
PORT=5002
TRUST_PROXY=true
SERVE_FRONTEND=true

# Database Configuration (DirectAdmin MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_SSL=false

# JWT — must be a long random secret (openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32-output-here
ENABLE_DEMO_AUTH=false
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-output-here

# Frontend origin for CORS
FRONTEND_URL=https://your-domain.com

# Baked into the SPA at build time
VITE_API_URL=https://your-domain.com/api

LOG_LEVEL=info
