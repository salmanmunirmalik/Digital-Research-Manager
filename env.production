# Production Environment Configuration - Simplified
NODE_ENV=production
PORT=10000

# Database Configuration
MYSQL_URL=mysql://digital_research_manager_user:password@localhost:3306/digital_research_manager

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS) — set to your real production origin
FRONTEND_URL=https://your-production-domain.com

# API Base URL - This is what the frontend will use
API_BASE_URL=https://your-production-domain.com

# CORS Configuration
CORS_ORIGIN=https://your-production-domain.com

# Logging
LOG_LEVEL=info
